# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Claude Code internal files
.claude/

# Runtime database files
*.db
*.db-shm
*.db-wal
*.duckdb
*.duckdb.wal
*.duckdb.migrated

# Logs (keep directory structure, ignore log files)
logs/**
!logs/**/.gitkeep

# Backtest results (generated output — CSVs, HTML reports, run logs, checkpoints)
backtest/results/
backtest/output.png

# Test output images
tests/outputs/

# Loose screenshots / debug images in root
ScreenShot_*.png
candle.png

# Runtime / scheduler logs in db/
db/scheduler.log

# Single-instance locks (core/single_instance.py) — one file per
# long-lived process, recreated on every start.
db/locks/

# Hang-watchdog thread-dump log (analysis/trade_viewer_qt.py, root dir)
hang_watchdog.log

# Output redirected by scripts/launch_*.vbs (hidden-window launchers)
scripts/*.log

# Docker — user secrets and local volume dirs (never commit)
docker/backtest.env
docker_db/
backtest_results/

# DB backups (e.g. db/ticks.db.bak_pre_soxl_only) — same size class as *.db,
# just a different suffix so the *.db rule above doesn't catch them
db/*.bak*

# Table dumps taken before a destructive migration (CSV, so *.db misses them)
db/archive/

# Derived parquet archives rebuilt from db/*.db (feeds/depth_bars.py,
# feeds/book_ladder.py) -- data, not code, and large
db/cache/

# API tokens / credentials accidentally dropped in repo root
github_token.txt
*_token.txt

# Drill question sets are generated data, not code
strategy/drill/questions_c*.js
strategy/drill/answer_order.js

# Ledger-sourced drill questions are generated data too
strategy/drill/questions_mine.js

# One-off analysis figures (analysis/outputs/) -- generated pictures of
# market data, same class as backtest/results/. The script that makes one
# belongs in git; the PNG it writes does not.
analysis/outputs/
