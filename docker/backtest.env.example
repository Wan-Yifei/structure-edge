# ──────────────────────────────────────────────────────────────────────────────
# moomoo-backtest Docker configuration
# Copy this file to docker/backtest.env and fill in your values.
# backtest.env is gitignored — do NOT commit credentials or bucket paths.
# ──────────────────────────────────────────────────────────────────────────────

# ── S3 / Wasabi storage ───────────────────────────────────────────────────────

# Bucket URI — must end without a trailing slash.
# Examples:
#   AWS S3:   s3://my-bucket/moomoo
#   Wasabi:   s3://my-wasabi-bucket/moomoo
S3_BUCKET=s3://your-bucket/moomoo

# AWS CLI profile name (from the credentials file on the host).
# The ~/.aws directory is mounted read-only into the container.
AWS_PROFILE=default

# Path to the credentials file INSIDE the container.
# The host ~/.aws/ directory is mounted to /home/backtest/.aws/.
# Set this to match the actual filename on your host:
#   Standard AWS CLI:  /home/backtest/.aws/credentials   (default)
#   Some HPC systems:  /home/backtest/.aws/credential    (no trailing 's')
AWS_SHARED_CREDENTIALS_FILE=/home/backtest/.aws/credentials

# Wasabi endpoint — leave blank for standard AWS S3.
# Wasabi region endpoints: https://knowledgebase.wasabi.com/hc/en-us/articles/360015106031
# Example: https://s3.us-east-1.wasabisys.com
AWS_ENDPOINT_URL=

# ── Backtest run ──────────────────────────────────────────────────────────────

# Path to the backtest config JSON (relative to /app inside the container).
# See config/backtest/ for available configs.
BACKTEST_CONFIG=config/backtest/cross_stock_grid_v2.json

# Number of parallel workers (leave blank to use the value from the config).
BACKTEST_WORKERS=

# Extra flags forwarded verbatim to backtest/run.py.
# Examples: --random 500 --no-resume --min-trades 15
BACKTEST_EXTRA_ARGS=

# Algo version tag to embed in trade IDs and the run-tagged DB filename.
# Set this to the most recent smc_v* git tag (e.g. smc_v2.4).
# Required because .git/ is excluded from the Docker image via .dockerignore;
# without this the algo version falls back to "smc_unknown".
ALGO_VERSION=smc_v2.4

# ── Audit / Inspect ───────────────────────────────────────────────────────────

# How many top-ranked combos to audit per stock code (default 3).
AUDIT_TOP_N=3

# Inspect window — subset of the backtest date range to examine rejection reasons.
# Leave blank to default to the full backtest date range.
# Must be YYYY-MM-DD.
INSPECT_START=
INSPECT_END=

# ── Upload results ────────────────────────────────────────────────────────────

# Set to "true" to sync the results directory back to S3 after the run.
UPLOAD_RESULTS=true

# Sub-path under S3_BUCKET where results are uploaded.
# Actual upload path: ${S3_BUCKET}/${RESULTS_S3_PREFIX}/<run-tag>/
RESULTS_S3_PREFIX=results

# ── Database files to download ────────────────────────────────────────────────
# Space-separated list of files to fetch from ${S3_BUCKET}/db/.
# backtest_klines.duckdb  — required: kline price history (~several GB)
# backtest.duckdb         — optional: previous trade records (created fresh if absent)
DB_FILES=backtest_klines.duckdb

# Set to "true" to skip the S3 download if the DB file already exists locally.
# Useful when re-running inside the same container or with a pre-populated bind mount.
SKIP_DOWNLOAD_IF_EXISTS=true
