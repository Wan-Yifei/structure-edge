  "target_categories": {
    "US.OKLO": "nuclear fusion & energy",
    "US.AAPL": "全部",
    "US.TSLA": "全部",
    "US.PLTR": "AI family",
    "US.GLW": "半导体",
    "US.SPCX": "Space X family",
    "US.SPCH": "Space X family"
  },
  "order_book_enabled": true,
  "remote_backup": {
    "enabled": true,
    "cron": "0 20 * * 1",
    "s3_bucket": "s3://dnanexus-nextflow-dev/db/",
    "aws_profile": "default",
    "aws_endpoint_url": "https://s3.wasabisys.com",
    "tick_db": "db/ticks.db",
    "order_book_db": "db/order_book.db"
  },
  "autostart": true,
  "scanner": {
    "enabled": [
      "US.SOXL"
    ],
    "scan_interval_s": 60,
    "alert_sound": true,
    "default": {
      "strategy": "smc",
      "auto_params": true,
      "lookback_months": 3,
      "min_n_trades": 5,
      "min_pf": 1.5,
      "entry_signal_enabled": true,
      "fvg_watch_enabled": false
    },
    "overrides": {
      "US.SOXL": {
        "entry_signal_enabled": false,
        "fvg_watch_enabled": true
      }
    }
  }
}